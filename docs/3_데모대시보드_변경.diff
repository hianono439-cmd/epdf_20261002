+<script>
+/* ===================== 전역 상태 ===================== */
+// 서버(data/features.py, monitoring/drift_detector.py)와 동일한 값 (상수만 복제)
+const SEQ_LEN = 14;          // 🔧 [전력수요 변경] 20 → 14
+const WINDOW_SIZE = 28;      // 🔧 [전력수요 변경] 21 → 28
+const RMSE_THRESHOLD = 75.0; // 🔧 [전력수요 변경] $4 → 75 GWh
+
+let lastPipelineRun = null; // { driftCheck, clientRmse, ts }
+
+// 🔧 [전력수요 변경] NORMAL_SIGMA / DRIFT_SIGMA / DEFAULT_BASE_PRICE (랜덤워크 설정) 삭제
+const PIPELINE_STAGES = [
+  { key: "collect", title: "데이터 수집", desc: "요청 수신" },
+  { key: "monitor", title: "데이터 모니터링", desc: "예측 기록 누적" },
+  { key: "detect", title: "드리프트 감지", desc: "RMSE vs 임계치" },
+  { key: "trigger", title: "재학습 트리거", desc: "조건 충족 시 시작" },
+  { key: "train", title: "모델 학습", desc: "fine-tuning" },
+  { key: "register", title: "모델 등록", desc: "MLflow Registry" },
+  { key: "deploy", title: "배포", desc: "Production 승격" },
+];
+
+/* ===================== 유틸 ===================== */
+// 🔧 [전력수요 변경] randn() / randomWalk() 삭제 — 배치는 서버의 GET /data/sample-batch 가 만듦
+function rmseOf(actual, predicted) {
+  const n = Math.min(actual.length, predicted.length);
+  if (n === 0) return null;
+  let sum = 0;
+  for (let i = 0; i < n; i++) sum += (actual[i] - predicted[i]) ** 2;
+  return Math.sqrt(sum / n);
+}
+function relTime(ts) {
+  if (!ts) return "-";
+  const diff = Math.max(0, Date.now() / 1000 - ts);
+  if (diff < 60) return `${Math.floor(diff)}초 전`;
+  if (diff < 3600) return `${Math.floor(diff / 60)}분 전`;
+  if (diff < 86400) return `${Math.floor(diff / 3600)}시간 전`;
+  return `${Math.floor(diff / 86400)}일 전`;
+}
+async function getJSON(path) {
+  const res = await fetch(path);
+  const data = await res.json().catch(() => null);
+  return { ok: res.ok, status: res.status, data };
+}
+// 서버가 500 등을 일반 텍스트("Internal Server Error")로 응답할 수도 있어
+// (예: model_loader.py의 _load_from_mlflow TODO가 아직 NotImplementedError를 던지는 경우),
+// res.json()을 바로 쓰지 않고 텍스트로 먼저 받아 파싱을 시도한다.
+async function safeJson(res) {
+  const text = await res.text();
+  try { return JSON.parse(text); } catch (e) { return { __raw: text || "(응답 없음)" }; }
+}
+function showResult(el, obj, isError = false) {
+  el.classList.add("show");
+  el.style.borderColor = isError ? "var(--err)" : "var(--border)";
+  el.textContent = typeof obj === "string" ? obj : JSON.stringify(obj, null, 2);
+}
+
+/* ===================== 데이터 업로드 ===================== */
+async function uploadFile() {
+  const input = document.getElementById("upload-input");
+  const statusEl = document.getElementById("upload-status");
+  if (!input.files.length) {
+    statusEl.innerHTML = `<span class="pill warn"><span class="dot"></span>파일을 먼저 선택하세요</span>`;
+    return;
+  }
+  const form = new FormData();
+  form.append("file", input.files[0]);
+  statusEl.innerHTML = `<span class="pill neutral"><span class="dot"></span>업로드 중…</span>`;
+  try {
+    const res = await fetch("/data/upload", { method: "POST", body: form });
+    const data = await safeJson(res);
+    if (!res.ok) {
+      statusEl.innerHTML = `<span class="pill err"><span class="dot"></span>${data.detail || "업로드 실패"}</span>`;
+      return;
+    }
+    statusEl.innerHTML = `<span class="pill ok"><span class="dot"></span>업로드 완료: ${data.filename} (${data.rows}행)</span>`;
+  } catch (e) {
+    statusEl.innerHTML = `<span class="pill err"><span class="dot"></span>요청 실패: ${e.message}</span>`;
+  }
+}
+
+/* ===================== 재학습 로그 ===================== */
+async function loadLogFiles() {
+  const { ok, data } = await getJSON("/logs");
+  const wrap = document.getElementById("log-file-list");
+  if (!ok || !data || !data.length) {
+    wrap.innerHTML = `<span class="pill neutral">아직 로그가 없습니다 - 드리프트 배치를 보내면 logs/aiops.log가 생깁니다</span>`;
+    return;
+  }
+  wrap.innerHTML = data.map((f) =>
+    `<button class="btn secondary" onclick="openLogFile('${f.name}')">${f.name} (${f.size}B)</button>`
+  ).join("");
+}
+async function openLogFile(name) {
+  const box = document.getElementById("log-content");
+  const { ok, data } = await getJSON(`/logs/${encodeURIComponent(name)}`);
+  if (!ok || !data) { showResult(box, "불러오기 실패", true); return; }
+  showResult(box, data.content || "(비어 있음)");
+}
+
+/* ===================== 파이프라인 시각화 ===================== */
+function renderPipeline() {
+  const track = document.getElementById("pipeline-track");
+  const badge = document.getElementById("pipeline-run-badge");
+
+  if (!lastPipelineRun) {
+    badge.className = "pill neutral"; badge.textContent = "아직 실행 안 함";
+    track.innerHTML = PIPELINE_STAGES.map((s, i) => stageHtml(s, i, "idle", "대기 중")).join("");
+    return;
+  }
+
+  const { driftCheck, ts } = lastPipelineRun;
+  badge.className = "pill neutral";
+  badge.textContent = `마지막 실행 ${relTime(ts)}`;
+
+  const serverStatus = driftCheck.status; // "ok" | "retrain_triggered"
+  const promoted = driftCheck.promoted;
+
+  let states; // 7개 단계 상태: idle | ok | warn
+  if (serverStatus === "retrain_triggered" && promoted === true) {
+    states = ["ok", "ok", "warn", "ok", "ok", "ok", "ok"];
+  } else if (serverStatus === "retrain_triggered" && promoted === false) {
+    states = ["ok", "ok", "warn", "ok", "ok", "warn", "idle"];
+  } else if (serverStatus === "retrain_triggered") {
+    states = ["ok", "ok", "warn", "idle", "idle", "idle", "idle"];
+  } else {
+    states = ["ok", "ok", "ok", "idle", "idle", "idle", "idle"];
+  }
+  const statusText = { ok: "완료", warn: "감지됨", idle: "대기 중" };
+
+  track.innerHTML = PIPELINE_STAGES.map((s, i) => stageHtml(s, i, states[i], statusText[states[i]])).join("");
+}
+function stageHtml(stage, idx, state, statusLabel) {
+  return `
+    <div class="pipe-stage ${state}">
+      <div class="pipe-title">${stage.title}</div>
+      <div class="pipe-desc">${stage.desc}</div>
+      <div class="pipe-status">${statusLabel}</div>
+    </div>`;
+}
+
+/* ===================== 드리프트 배치 전송 ===================== */
+async function sendBatch(kind) {
+  const statusEl = document.getElementById("drift-status");
+  const resultBox = document.getElementById("drift-result");
+  // 🔧 [전력수요 변경] 브라우저 랜덤워크 → 서버에서 2025년 실제 42일 배치(records)를 받아 그대로 전송
+  const scenario = document.getElementById("scenario-select").value;
+
+  statusEl.innerHTML = `<span class="pill warn"><span class="dot"></span>전송 중… (fine-tuning이 걸리면 수십 초 걸릴 수 있습니다)</span>`;
+
+  try {
+    const batchRes = await fetch(`/data/sample-batch?kind=${kind}&scenario=${scenario}`);
+    const batch = await safeJson(batchRes);
+    if (!batchRes.ok) {
+      statusEl.innerHTML = `<span class="pill err"><span class="dot"></span>${batch.detail || "배치 생성 실패 - CSV를 먼저 업로드하세요"}</span>`;
+      return;
+    }
+    const records = batch.records;
+    const res = await fetch("/predict/batch-test", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ records }) });
+    const data = await safeJson(res);
+    if (!res.ok) {
+      const reason = data.__raw
+        ? "서버 오류 - model_loader.py 또는 predict.py의 TODO가 아직 구현되지 않았을 수 있습니다"
+        : "오류 (TODO 미구현일 수 있음)";
+      statusEl.innerHTML = `<span class="pill err"><span class="dot"></span>${reason}</span>`;
+      showResult(resultBox, { status: res.status, detail: data }, true);
+      return;
+    }
+    // 🔧 [전력수요 변경] 실제값은 서버 응답의 actuals 사용 (슬라이딩 윈도우 규칙은 빈칸 6과 동일: i + SEQ_LEN)
+    const actual = data.actuals || records.slice(SEQ_LEN).map((r) => r.demand);
+    const clientRmse = rmseOf(actual, data.predictions || []);
+
+    lastPipelineRun = { driftCheck: data.drift_check || {}, clientRmse, ts: Date.now() / 1000 };
+    renderPipeline();
+    loadLogFiles();
+
+    const check = data.drift_check || {};
+    let level = "ok", label = `정상 (드리프트 없음 · 최근 ${WINDOW_SIZE}일 RMSE ${check.rmse?.toFixed?.(1) ?? "-"} GWh ≤ ${RMSE_THRESHOLD})`;
+    if (check.status === "retrain_triggered" && check.promoted) {
+      level = "ok"; label = `드리프트(${check.drift_rmse?.toFixed?.(1)} GWh) → 재학습 완료 · 새 버전 승격 (rmse=${check.rmse?.toFixed?.(1) ?? check.rmse}, 기존 ${check.champion_rmse?.toFixed?.(1)})`;
+    } else if (check.status === "retrain_triggered" && check.promoted === false) {
+      level = "warn"; label = `드리프트 감지 · 재학습했지만 게이트 미통과 (rmse=${check.rmse?.toFixed?.(1) ?? check.rmse}, 기존 ${check.champion_rmse?.toFixed?.(1)})`;
+    } else if (check.status === "retrain_triggered") {
+      level = "warn"; label = "드리프트 감지 · 재학습 트리거됨";
+    }
+    statusEl.innerHTML = `
+      <span class="pill ${level}"><span class="dot"></span>${label}</span>
+      <span class="pill neutral" style="margin-left:6px;">클라이언트 계산 RMSE: ${clientRmse != null ? clientRmse.toFixed(1) + " GWh" : "-"}</span>`;
+    showResult(resultBox, data, false);
+  } catch (e) {
+    statusEl.innerHTML = `<span class="pill err"><span class="dot"></span>연결 실패</span>`;
+    showResult(resultBox, "요청 실패: " + e.message, true);
+  }
+}
+
+/* ===================== 초기화 ===================== */
+async function init() {
+  renderPipeline();
+  loadLogFiles();
+}
+init();
+</script>
+</body>
+</html>
